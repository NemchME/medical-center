generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id            BigInt    @id @default(autoincrement())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  fullName      String    @map("full_name")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")

  profile       UserProfile?
  roles         UserRole[]
  documents     UserDocument[]
  doctor        Doctor?
  patient       Patient?

  @@map("user")
}

model UserProfile {
  userId    BigInt   @id @map("user_id")
  birthDate DateTime? @map("birth_date") @db.Date
  phone     String?
  gender    String?
  address   String?
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile")
}

model Role {
  id       BigInt  @id @default(autoincrement())
  name     String  @unique
  isActive Boolean @default(true) @map("is_active")

  users UserRole[]

  @@map("role")
}

model UserRole {
  userId BigInt @map("user_id")
  roleId BigInt @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role")
}


model DocumentType {
  id       BigInt  @id @default(autoincrement())
  code     String  @unique
  name     String
  isActive Boolean @default(true) @map("is_active")

  documents UserDocument[]

  @@map("document_type")
}

model FileStorage {
  id         BigInt   @id @default(autoincrement())
  storageKey String   @unique @map("storage_key")
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  sizeBytes  BigInt   @map("size_bytes")
  checksum   String?
  createdAt  DateTime @default(now()) @map("created_at")

  documents UserDocument[]

  @@map("file_storage")
}

model UserDocument {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @map("user_id")
  documentTypeId BigInt   @map("document_type_id")
  number         String?
  issuedBy       String?  @map("issued_by")
  issuedAt       DateTime? @map("issued_at") @db.Date
  expiresAt      DateTime? @map("expires_at") @db.Date
  fileId         BigInt?  @map("file_id")
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType DocumentType @relation(fields: [documentTypeId], references: [id])
  file         FileStorage? @relation(fields: [fileId], references: [id])

  @@map("user_document")
}


model ClinicCenter {
  id       BigInt  @id @default(autoincrement())
  code     String  @unique
  name     String
  address  String?
  phone    String?
  email    String?
  timezone String  @default("Europe/Moscow")
  isActive Boolean @default(true) @map("is_active")

  doctors       Doctor[]
  appointments  Appointment[]
  servicePrices ServicePrice[]
  testPrices    TestPrice[]

  @@map("clinic_center")
}

model Doctor {
  id             BigInt  @id @default(autoincrement())
  userId         BigInt? @unique @map("user_id")
  centerId       BigInt  @map("center_id")
  fullName       String  @map("full_name")
  specialization String?
  photoUrl       String? @map("photo_url")
  experience     String?
  education      String?
  bio            String?
  isActive       Boolean @default(true) @map("is_active")

  user         User?         @relation(fields: [userId], references: [id])
  center       ClinicCenter  @relation(fields: [centerId], references: [id])
  appointments Appointment[]
  schedules    DoctorSchedule[]

  @@map("doctor")
}

model DoctorSchedule {
  id        BigInt   @id @default(autoincrement())
  doctorId  BigInt   @map("doctor_id")
  dayOfWeek Int      @map("day_of_week") 
  startTime String   @map("start_time") 
  endTime   String   @map("end_time")
  slotMin   Int      @default(30) @map("slot_min")
  isActive  Boolean  @default(true) @map("is_active")

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek])
  @@map("doctor_schedule")
}


model Service {
  id                 BigInt  @id @default(autoincrement())
  code               String  @unique
  name               String
  description        String?
  durationMinDefault Int     @default(30) @map("duration_min_default")
  isActive           Boolean @default(true) @map("is_active")

  prices              ServicePrice[]
  appointmentServices AppointmentService[]

  @@map("service")
}

model ServicePrice {
  id        BigInt   @id @default(autoincrement())
  centerId  BigInt   @map("center_id")
  serviceId BigInt   @map("service_id")
  price     Decimal  @db.Decimal(10, 2)
  currency  String   @default("RUB")
  validFrom DateTime @default(now()) @map("valid_from")
  validTo   DateTime? @map("valid_to")
  isActive  Boolean  @default(true) @map("is_active")

  center  ClinicCenter @relation(fields: [centerId], references: [id])
  service Service      @relation(fields: [serviceId], references: [id])

  @@map("service_price")
}

model LabTest {
  id          BigInt  @id @default(autoincrement())
  code        String  @unique
  name        String
  description String?
  sampleType  String? @map("sample_type")
  preparation String?
  isActive    Boolean @default(true) @map("is_active")

  prices           TestPrice[]
  appointmentTests AppointmentTest[]
  testResults      TestResult[]

  @@map("lab_test")
}

model TestPrice {
  id        BigInt   @id @default(autoincrement())
  centerId  BigInt   @map("center_id")
  testId    BigInt   @map("test_id")
  price     Decimal  @db.Decimal(10, 2)
  currency  String   @default("RUB")
  validFrom DateTime @default(now()) @map("valid_from")
  validTo   DateTime? @map("valid_to")
  isActive  Boolean  @default(true) @map("is_active")

  center ClinicCenter @relation(fields: [centerId], references: [id])
  test   LabTest      @relation(fields: [testId], references: [id])

  @@map("test_price")
}

model Patient {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt?  @unique @map("user_id")
  fullName  String   @map("full_name")
  birthDate DateTime? @map("birth_date") @db.Date
  phone     String?
  email     String?
  gender    String?
  address   String?
  isActive  Boolean  @default(true) @map("is_active")

  user         User?         @relation(fields: [userId], references: [id])
  appointments Appointment[]
  testResults  TestResult[]

  @@map("patient")
}


model Appointment {
  id            BigInt   @id @default(autoincrement())
  patientId     BigInt   @map("patient_id")
  doctorId      BigInt   @map("doctor_id")
  centerId      BigInt   @map("center_id")
  startAt       DateTime @map("start_at")
  durationMin   Int      @default(30) @map("duration_min")
  status        String   @default("pending")
  createdAt     DateTime @default(now()) @map("created_at")
  sourceChannel String?  @map("source_channel")

  patient       Patient       @relation(fields: [patientId], references: [id])
  doctor        Doctor        @relation(fields: [doctorId], references: [id])
  center        ClinicCenter  @relation(fields: [centerId], references: [id])

  visit         Visit?
  notifications Notification[]
  prediction    MlPrediction?
  services      AppointmentService[]
  tests         AppointmentTest[]

  @@map("appointment")
}


model Visit {
  id            BigInt    @id @default(autoincrement())
  appointmentId BigInt    @unique @map("appointment_id")
  complaints    String?
  diagnosis     String?
  examination   String?
  notes         String?
  closedAt      DateTime? @map("closed_at")

  appointment   Appointment    @relation(fields: [appointmentId], references: [id])
  prescriptions Prescription[]

  @@map("visit")
}

model Prescription {
  id        BigInt   @id @default(autoincrement())
  visitId   BigInt   @map("visit_id")
  text      String
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@map("prescription")
}

model TestResult {
  id        BigInt   @id @default(autoincrement())
  patientId BigInt   @map("patient_id")
  testId    BigInt   @map("test_id")
  result    String
  unit      String?
  refRange  String?  @map("ref_range") 
  status    String   @default("pending")
  takenAt   DateTime @default(now()) @map("taken_at")
  readyAt   DateTime? @map("ready_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  test    LabTest @relation(fields: [testId], references: [id])

  @@map("test_result")
}

model Notification {
  id            BigInt    @id @default(autoincrement())
  appointmentId BigInt    @map("appointment_id")
  type          String
  plannedAt     DateTime  @map("planned_at")
  sentAt        DateTime? @map("sent_at")
  status        String    @default("pending")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("notification")
}

model MlPrediction {
  id                BigInt   @id @default(autoincrement())
  appointmentId     BigInt   @unique @map("appointment_id")
  noShowProbability Float    @map("no_show_probability")
  modelVersion      String   @map("model_version")
  createdAt         DateTime @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("ml_prediction")
}

model AppointmentService {
  id            BigInt   @id @default(autoincrement())
  appointmentId BigInt   @map("appointment_id")
  serviceId     BigInt   @map("service_id")
  qty           Int      @default(1)
  unitPrice     Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice    Decimal  @map("total_price") @db.Decimal(10, 2)
  status        String   @default("pending")
  createdAt     DateTime @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@map("appointment_service")
}

model AppointmentTest {
  id            BigInt   @id @default(autoincrement())
  appointmentId BigInt   @map("appointment_id")
  testId        BigInt   @map("test_id")
  qty           Int      @default(1)
  unitPrice     Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice    Decimal  @map("total_price") @db.Decimal(10, 2)
  status        String   @default("pending")
  createdAt     DateTime @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  test        LabTest     @relation(fields: [testId], references: [id])

  @@map("appointment_test")
}
